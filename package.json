{
  "name": "population-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Browser population simulation game. Plain ES modules, no build step.",
  "type": "module",
  "scripts": {
    "start": "node tools/serve.js",
    "test": "npm run test:unit",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "playwright test",
    "headless": "node tools/headless.js",
    "perf": "node tools/headless.js --ticks 2000 --size 100 --min-tps 150"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  }
}
